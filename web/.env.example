# Wallet / chain — server reads these; the browser only sees short __AF_* aliases.
ARCFLOW_MODE=testnet
CHAIN_ID=5042002
ARC_TESTNET_RPC=https://rpc.testnet.arc.network
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
# ARC_MAINNET_RPC=https://rpc.arc.network

# Reown AppKit (https://dashboard.reown.com)
REOWN_PROJECTID=

# Contract addresses
ARCFLOW_ADDRESS=0x0000000000000000000000000000000000000000
ARCFLOW_STREAM_ADDRESS=0x0000000000000000000000000000000000000000
ARCFLOW_DISTRIBUTOR_ADDRESS=0x0000000000000000000000000000000000000000
ARCFLOW_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
ARCFLOW_STAKING_ADDRESS=0x0000000000000000000000000000000000000000

# Server-only API (browser uses /api/af proxy)
ARCFLOW_API_URL=http://localhost:4000
ARCFLOW_API_KEY=

# Public site URL — used for og:image / canonical URLs (set in Railway prod)
# Production must be the public HTTPS origin, never localhost.
SITE_URL=https://arcflows.finance
NEXT_PUBLIC_SITE_URL=https://arcflows.finance
