# Copy to .env and fill in. .env is gitignored - never commit real keys.

ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
CHAIN_ID=5042

# Address that owns the five proxies and may upgrade them.
# Use a multisig: this key can replace the logic of every proxied contract.
ARCFLOW_OWNER=0x0000000000000000000000000000000000000000

# Platform fee wallet (public address). Receives the treasury share after fee split.
ARCFLOW_TREASURY=0x0000000000000000000000000000000000000000

# Referral pool wallet (public address). Receives referralRateBps on attributed locks.
ARCFLOW_REFERRAL_WALLET=0x9819bdb58f321ed18Ef8249a12eE4aa273A25889

# Used by script/Upgrade.s.sol and ConfigureLock.s.sol.
ARCFLOW_PROXY=0x0000000000000000000000000000000000000000
ARCFLOW_TARGET=lock
# ARCFLOW_REFERRAL_RATE_BPS=1500

# Deploying
# ---------
# Import the deployer once into an encrypted keystore instead of exporting a raw key:
#   cast wallet import arcflow-deployer --interactive
#
#   forge script script/Deploy.s.sol:Deploy \
#     --rpc-url $ARC_MAINNET_RPC_URL \
#     --account arcflow-deployer \
#     --broadcast
#
# Upgrading a proxy later
# -----------------------
#   ARCFLOW_PROXY=<proxy address> ARCFLOW_TARGET=stream \
#   forge script script/Upgrade.s.sol:Upgrade \
#     --rpc-url $ARC_MAINNET_RPC_URL \
#     --account arcflow-deployer \
#     --broadcast
#
# Arc notes: chain ID 5042 (mainnet) / 5042002 (testnet), gas is paid in USDC, and the
# mempool rejects maxFeePerGas below 20 gwei. Add --with-gas-price 20gwei if a send is rejected.
