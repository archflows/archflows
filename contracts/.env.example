# Copy to .env and fill in. .env is gitignored - never commit real keys.

ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Address that owns the four proxies and may upgrade them.
# Use a multisig before mainnet: this key can replace the logic of every proxied contract.
ARCFLOW_OWNER=0x0000000000000000000000000000000000000000

# Used by script/Upgrade.s.sol only.
ARCFLOW_PROXY=0x0000000000000000000000000000000000000000
ARCFLOW_TARGET=stream

# Deploying
# ---------
# Import the deployer once into an encrypted keystore instead of exporting a raw key:
#   cast wallet import arcflow-deployer --interactive
#
# Fund it with testnet USDC first: https://faucet.circle.com
#
#   forge script script/Deploy.s.sol:Deploy \
#     --rpc-url $ARC_TESTNET_RPC_URL \
#     --account arcflow-deployer \
#     --broadcast
#
# Upgrading a proxy later
# -----------------------
#   ARCFLOW_PROXY=<proxy address> ARCFLOW_TARGET=stream \
#   forge script script/Upgrade.s.sol:Upgrade \
#     --rpc-url $ARC_TESTNET_RPC_URL \
#     --account arcflow-deployer \
#     --broadcast
#
# Arc notes: chain ID 5042002, gas is paid in USDC, and the mempool rejects
# maxFeePerGas below 20 gwei. Add --with-gas-price 20gwei if a send is rejected.
