PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/arcflow

# Seeded into api_keys on boot. Backend checks the table, not only env.
# Client key for the web app / public consumers.
API_KEY=replace-with-a-long-random-key
# API_KEYS=key-one,key-two
# Admin key — required to create/list/revoke public keys via /v1/keys
# ADMIN_API_KEY=replace-with-admin-key

# Loose per-IP limit on /v1 (not per API key). 600 / 60s. 0 disables.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# Query / health caches. Writes on /v1 bust the stats cache.
STATS_CACHE_MS=5000
HEALTH_CACHE_MS=2500
PG_POOL_MAX=20
# App-level query timeout (ms). Not sent as a Postgres startup param — safe with Railway/PgBouncer.
PG_STATEMENT_TIMEOUT_MS=8000

# CORS: comma-separated origins, or * for any.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Swagger UI (/docs) logins are stored in docs_users (seeded from env).
SWAGGER_USER=arcflow
SWAGGER_PASSWORD=replace-with-a-strong-password
SWAGGER_PARTNER_USER=partner
SWAGGER_PARTNER_PASSWORD=replace-with-a-partner-password

# Same names as web/.env so values can be copied across.
ARCFLOW_MODE=mainnet
CHAIN_ID=5042
ARC_RPC=https://rpc.mainnet.arc.io
ARC_MAINNET_RPC=https://rpc.mainnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC=https://rpc.testnet.arc.network
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

ARCFLOW_ADDRESS=0xCD1bEeE5856Cd0c57931258d9621FeB2052B5481
ARCFLOW_STREAM_ADDRESS=0x4c6AaE1aDE8ec4f7b2E7f76135b203Fc0A500516
ARCFLOW_DISTRIBUTOR_ADDRESS=0x01CA506129dd74E5e2302eaD2A9ae75Ef80E0047
ARCFLOW_ESCROW_ADDRESS=0x814ea63b4B01e6d36617FDdDc9B5B05ca17c544F
ARCFLOW_STAKING_ADDRESS=0x290D0ED8823E5E18B19113C0Af5b8F84580D58F5
ARCFLOW_TREASURY=0x257666FaAd2A70180A5608711fBbe2A5B5BFE6C5
ARCFLOW_REFERRAL_WALLET=0x9819bdb58f321ed18Ef8249a12eE4aa273A25889
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Fee policy, in USDC 6-decimal units.
# Single lock: $10. Split: $15 once on-chain (lockSplit). Referral is 15% of whichever fee
# was paid — share to ARCFLOW_REFERRAL_WALLET, rest to ARCFLOW_TREASURY.
LOCK_FEE_USDC_UNITS=10000000
SPLIT_LOCK_FEE_USDC_UNITS=15000000

# Referral program.
# Referrer earns REFERRAL_RATE_BPS of the USDC fee their referee paid, and the platform
# keeps REFERRAL_PLATFORM_BPS of that commission. 1500 + 2000 => referrer nets 12% of the fee.
REFERRAL_RATE_BPS=1500
REFERRAL_PLATFORM_BPS=2000
# Minimum withdrawal, in USDC 6-decimal units. 5000000 = 5 USDC.
REFERRAL_MIN_WITHDRAW_USDC=5000000
# Referral fees land in ARCFLOW_REFERRAL_WALLET. Claims are relayed by the backend via
# withdrawReferral() — the pool wallet must approve the lock proxy for USDC (see ApproveReferralPool.s.sol).
ARCFLOW_WITHDRAW_EXECUTOR_KEY=
# Platform treasury key — same wallet as ARCFLOW_TREASURY. Only needed for leftover rebates
# from old split creates that paid $10 per wallet. New splits charge $15 on-chain; no rebate.
# ARCFLOW_TREASURY_KEY=
# ARCFLOW_FEE_WALLET_KEY=

# Aliases without NEXT_PUBLIC_ also work.
# ARCFLOW_ADDRESS=
# ARCFLOW_STREAM_ADDRESS=
# ARCFLOW_DISTRIBUTOR_ADDRESS=
# ARCFLOW_ESCROW_ADDRESS=
# ARCFLOW_STAKING_ADDRESS=
